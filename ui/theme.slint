// Colours and metrics for the settings window: a dark theme with the teal accent of the TV app.
export global Theme {
    out property <color> bg: #0c0f13;
    out property <color> sidebar: #101318;
    out property <color> surface: #151920;
    out property <color> surface-2: #1b2028;
    out property <color> surface-3: #232933;
    out property <color> border: #222831;
    out property <color> border-strong: #2f3641;
    out property <color> text: #e8ecf1;
    out property <color> text-2: #c3cad3;
    out property <color> muted: #8a94a0;
    out property <color> faint: #5b6470;
    out property <color> accent: #4ecca3;
    out property <color> accent-hover: #66d9b4;
    out property <color> accent-pressed: #3fb890;
    out property <color> accent-soft: #4ecca31f;
    out property <color> on-accent: #05261b;
    out property <color> danger: #f2777a;
    out property <color> danger-soft: #f2777a1f;
    out property <color> warning: #f0b429;
    out property <color> warning-soft: #f0b4291f;
    out property <string> icons: "Segoe MDL2 Assets";
    out property <length> radius: 14px;
    out property <length> control-radius: 8px;
}
